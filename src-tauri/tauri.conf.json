{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MuYu",
  "mainBinaryName": "MuYu",
  "version": "0.2.5",
  "identifier": "org.muyu.teleprompter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "幕语",
        "width": 550,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "center": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "幕语 · 启动",
        "width": 550,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; connect-src 'self' https://cdn.jsdelivr.net https://github.com; font-src 'self' data:; worker-src 'self' blob: https://cdn.jsdelivr.net",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$LOCALAPPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
